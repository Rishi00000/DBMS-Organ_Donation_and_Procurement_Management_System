{
  "name": "odpms-backend",
  "version": "1.0.0",
  "description": "Backend API for Organ Donation and Procurement Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "psql -U postgres -d odpms_db -f database/schema.sql && psql -U postgres -d odpms_db -f database/init.sql",
